# Copy to `supabase/.env` in this folder. Supabase CLI loads it for `supabase start`.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application):
# - Authorized JavaScript origins: http://localhost:3000  and/or  http://127.0.0.1:3000
# - Authorized redirect URIs: http://127.0.0.1:54321/auth/v1/callback
#   (use the exact URL from `supabase status` → API URL + /auth/v1/callback)
#
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
