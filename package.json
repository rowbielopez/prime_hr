{
  "name": "prime-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local --yes",
    "db:push": "supabase db push --yes",
    "db:pull": "supabase db pull",
    "db:seed": "supabase db reset --local --yes",
    "sb:link": "supabase link",
    "db:push:local": "supabase db push --local --yes",
    "db:reset:linked": "supabase db reset --linked --yes",
    "db:migration:list": "supabase migration list",
    "db:gen-types": "supabase gen types typescript --local > src/lib/db/database.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "legacy:analyze": "tsx scripts/migration/legacy-hris/analyze-sql.ts",
    "legacy:mismatch": "tsx scripts/analyze-hris-employee-service-records.ts",
    "legacy:dump": "tsx scripts/migration/legacy-hris/dump-to-ndjson.ts",
    "legacy:load": "tsx scripts/migration/legacy-hris/load-staging.ts",
    "legacy:validate": "tsx scripts/migration/legacy-hris/validate-staging.ts",
    "legacy:migrate": "tsx scripts/migration/legacy-hris/migrate.ts",
    "legacy:migrate:service-records": "tsx scripts/migration/legacy-hris/migrate-service-records.ts",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "supabase": "^2.90.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
