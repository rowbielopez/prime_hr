# Copy to `.env.local` for Next.js. Values come from `supabase status` after local stack is up.

# API URL (default local Supabase API port)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Project Settings → API → anon public (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role (server-only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated domains allowed after Google OAuth (enforced in /auth/callback)
# Example: csu.edu.ph,carsu.edu.ph
ALLOWED_EMAIL_DOMAINS=

# Upstash Redis — used by the public-careers rate limiter on serverless deployments.
# When absent the rate limiter falls back to an in-memory store (dev only).
# Create a Redis database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
